# Copy to bot.env, chmod 600. NEVER commit or paste this file in chat.
# Secrets (RYVER_PASSWORD, RYVER_ALERTS_WEBHOOK_KEY) are best supplied by the bot
# platform's secret store as environment variables; leave them out of this file if so.
RYVER_ORG=jigsawhealth
RYVER_USER=yourbothandle            # the bot's own Ryver username, e.g. quincy
# RYVER_PASSWORD=                   # secret: set via secure secret form
RYVER_ALERTS_WEBHOOK_URL=           # your "Ryver Live Alerts (@handle)" routine webhook URL
# RYVER_ALERTS_WEBHOOK_KEY=         # secret: that routine's key
RYVER_GROUP_MENTIONS=team,here,all  # set empty to ignore @team/@here/@all
RYVER_WATCH_ROOMS=                  # optional: rooms to forward EVERYTHING from (mentions need no list)
RYVER_POLL_INTERVAL=60
RYVER_STATE_DIR=./state
